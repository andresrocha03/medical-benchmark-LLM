{
  "input_files": {
    "train": "data/pre-processed/serialization/heart_train.csv",
    "test": "data/pre-processed/serialization/heart_test.csv"
  },
  "output_files": {
    "train": "data/serialized/heart_train_serialized.csv",
    "test": "data/serialized/heart_test_serialized.csv"
  },

  "column_names": [
    "age",
    "sex",
    "cp",
    "trestbps",
    "chol",
    "fbs",
    "restecg",
    "thalach",
    "exang",
    "oldpeak",
    "slope",
    "ca",
    "thal",
    "target"
  ],

  "target_col": "target",

  "target_mapping": {
    "0": "no heart disease",
    "1": "heart disease"
  },

  "column_mappings": {
    "sex": {
      "0": "female",
      "1": "male"
    },
    "cp": {
      "1": "typical angina",
      "2": "atypical angina",
      "3": "non-anginal pain",
      "4": "asymptomatic"
    },
    "fbs": {
      "0": "false",
      "1": "true"
    },
    "restecg": {
      "0": "normal",
      "1": "ST-T wave abnormality",
      "2": "left ventricular hypertrophy"
    },
    "exang": {
      "0": "no",
      "1": "yes"
    },
    "slope": {
      "1": "upsloping",
      "2": "flat",
      "3": "downsloping"
    },
    "ca": {
      "0": "0 major vessels",
      "1": "1 major vessel",
      "2": "2 major vessels",
      "3": "3 major vessels"
    },
    "thal": {
      "3": "normal",
      "6": "fixed defect",
      "7": "reversible defect"
    }
  },

  "numeric_cols": [
    "age",
    "trestbps",
    "chol",
    "thalach",
    "oldpeak"
  ]
}
